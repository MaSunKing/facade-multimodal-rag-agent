# Local Qwen3-VL model directory. Model weights are not included in this repo.
FACADE_MODEL_PATH=C:/models/Qwen3-VL-8B-Instruct

# Allowed static frontend origins, comma-separated. Use * only for local demo.
FACADE_PUBLIC_FRONTEND=http://localhost:3000

# Optional absolute MinerU executable path.
MINERU_EXECUTABLE=C:/path/to/mineru.exe

# Optional local hybrid retrieval. Set 0 to use BM25 only.
RAG_HYBRID_ENABLED=0
RAG_RETRIEVAL_DEVICE=cpu

# Optional public web search. Never put real keys in source control.
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# Frontend API base, injected during frontend build.
NEXT_PUBLIC_MODEL_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
