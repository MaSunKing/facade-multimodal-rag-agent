# Local Qwen3-VL model directory. Model weights are not included in this repo.
FACADE_MODEL_PATH=C:/models/Qwen3-VL-8B-Instruct

# Allowed static frontend origins, comma-separated. Use * only for local demo.
FACADE_PUBLIC_FRONTEND=http://localhost:3000

# Optional absolute MinerU executable path.
MINERU_EXECUTABLE=C:/path/to/mineru.exe

# Optional local hybrid retrieval. Set 0 to use BM25 only.
RAG_HYBRID_ENABLED=0
RAG_RETRIEVAL_DEVICE=cpu

# Optional Baidu AI Search. Permission in the UI does not force every turn to
# search. Never put a real key in source control.
BAIDU_AI_SEARCH_API_KEY=
WEB_SEARCH_DAILY_BUSINESS_LIMIT=45
WEB_SEARCH_DAILY_HARD_LIMIT=50
WEB_PAGE_VERIFICATION_ENABLED=1

# Question-driven customer attachment context. Canonical Evidence remains
# complete; these values only bound one model input snapshot.
CUSTOMER_ATTACHMENT_TEXT_TOKEN_BUDGET=5000
CUSTOMER_ATTACHMENT_TEXT_TOKEN_SAFETY_MAX=10000
CUSTOMER_ATTACHMENT_TEXT_WINDOW_TOKENS=768
CUSTOMER_ATTACHMENT_TEXT_WINDOW_OVERLAP_TOKENS=96

# Release the 8B generation model after twenty idle minutes. Set 0 only for an
# explicitly warm, dedicated inference machine.
FACADE_MODEL_IDLE_UNLOAD_SECONDS=1200

# Final prompt uses the real model tokenizer; candidates above are estimates.
CUSTOMER_GENERATION_MAX_PROMPT_TOKENS=5800
CUSTOMER_DOCUMENT_OCR_ENABLED=0

# Local access control and audit state. Runtime databases, bootstrap tokens and
# signed-visual secrets are generated locally and must never be committed.
FACADE_STATE_DB=runtime/facade_state.sqlite3
FACADE_AUTH_SESSION_HOURS=12

# Frontend API base, injected during frontend build.
NEXT_PUBLIC_MODEL_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
